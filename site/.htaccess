# SPDX-License-Identifier: CECILL-2.1
# Réglages du serveur Apache de l'hébergement OVH.

# Toujours en HTTPS, et sur dnmax.fr plutôt que www.dnmax.fr.
# Derrière l'infrastructure d'OVH, la variable HTTPS n'est pas fiable : c'est le port qui le dit.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://dnmax.fr%{REQUEST_URI} [L,R=301]
</IfModule>

# Les référentiels et les installeurs se téléchargent au lieu de s'afficher.
<FilesMatch "\.(dnmax|exe|dmg|deb)$">
  ForceType application/octet-stream
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment"
  </IfModule>
</FilesMatch>

# Les installeurs gardent le même nom d'une version à l'autre. Sans consigne, un navigateur
# qui en a déjà téléchargé un peut resservir sa copie, donc l'ancienne version : il doit
# redemander au serveur si le fichier a changé avant de s'en servir. Même chose pour les
# empreintes et le manifeste des mises à jour, déposés avec eux.
<IfModule mod_headers.c>
  <FilesMatch "(\.(exe|dmg|deb)|^SHA256SUMS\.txt|^latest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Pas de liste des fichiers d'un dossier sans page d'accueil.
Options -Indexes
