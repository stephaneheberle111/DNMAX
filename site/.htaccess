# Réglages du serveur Apache de l'hébergement OVH.

# Toujours en HTTPS, et sur dnmax.fr plutôt que www.dnmax.fr.
# Derrière l'infrastructure d'OVH, la variable HTTPS n'est pas fiable : c'est le port qui le dit.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://dnmax.fr%{REQUEST_URI} [L,R=301]
</IfModule>

# Les référentiels se téléchargent au lieu de s'afficher comme du texte.
<FilesMatch "\.dnmax$">
  ForceType application/octet-stream
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment"
  </IfModule>
</FilesMatch>

AddType font/woff2 .woff2

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Pas de liste des fichiers d'un dossier sans page d'accueil.
Options -Indexes
