, "dn": "DNO3"}]}, {"code": "C9.1", "libelle": "Faire état d'une écriture et d'une pratique expérimentale personnelle : des dimensions plastique, sensorielle, graphique, volumique,fonctionnelles technologique, structurelle et signifiante des objets et de leur structuration.", "bloc": "9", "ecs": [{"ec": "EC 2.1", "nom": "Outils d'expression et d'exploration créative", "ue": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "sem": "S1", "dn": "DNO1"}, {"ec": "EC 2.1", "nom": "Outils d'expression et d'exploration créative", "ue": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "sem": "S2", "dn": "DNO1"}, {"ec": "EC 10.1", "nom": "Outils d'expression et d'exploration créative", "ue": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "sem": "S3", "dn": "DNO2"}, {"ec": "EC 10.1", "nom": "Outils d'expression et d'exploration créative", "ue": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "sem": "S4", "dn": "DNO2"}, {"ec": "EC 18.1", "nom": "Outils d'expression et d'exploration créative", "ue": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "sem": "S5", "dn": "DNO3"}, {"ec": "EC 18.1", "nom": "Outils d'expression et d'exploration créative", "ue": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "sem": "S6", "dn": "DNO3"}, {"ec": "EC 11.2", "nom": "Pratiques et mises en œuvre du projet", "ue": "UE ATELIERS DE CREATION", "sem": "S4", "dn": "DNO2"}, {"ec": "EC 19.2", "nom": "Pratiques et mises en œuvre du projet", "ue": "UE ATELIERS DE CREATION", "sem": "S5", "dn": "DNO3"}, {"ec": "EC 19.2", "nom": "Pratiques et mises en œuvre du projet", "ue": "UE ATELIERS DE CREATION", "sem": "S6", "dn": "DNO3"}, {"ec": "EC 11.3", "nom": "Communication et médiation du projet", "ue": "UE ATELIERS DE CREATION", "sem": "S4", "dn": "DNO2"}, {"ec": "EC 19.3", "nom": "Communication et médiation du projet", "ue": "UE ATELIERS DE CREATION", "sem": "S5", "dn": "DNO3"}, {"ec": "EC 19.3", "nom": "Communication et médiation du projet", "ue": "UE ATELIERS DE CREATION", "sem": "S6", "dn": "DNO3"}, {"ec": "EC 12", "nom": "Parcours de pro