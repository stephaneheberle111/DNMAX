 "dn": "DNO2"}, {"ec": "EC 19.3", "nom": "Communication et médiation du projet", "ue": "UE ATELIERS DE CREATION", "sem": "S5", "dn": "DNO3"}, {"ec": "EC 19.3", "nom": "Communication et médiation du projet", "ue": "UE ATELIERS DE CREATION", "sem": "S6", "dn": "DNO3"}, {"ec": "EC 11.4", "nom": "Démarche de recherche en lien avec la pratique de projet", "ue": "UE ATELIERS DE CREATION", "sem": "S4", "dn": "DNO2"}, {"ec": "EC 19.4", "nom": "Démarche de recherche en lien avec la pratique de projet", "ue": "UE ATELIERS DE CREATION", "sem": "S5", "dn": "DNO3"}]}, {"code": "C2.1", "libelle": "Se servir aisément des différents registres d'expression écrite et orale de la langue française.", "bloc": "2", "ecs": [{"ec": "EC 1.1", "nom": "Humanités", "ue": "UE HUMANITES et CULTURE", "sem": "S1", "dn": "DNO1"}, {"ec": "EC 1.1", "nom": "Humanités", "ue": "UE HUMANITES et CULTURE", "sem": "S2", "dn": "DNO1"}, {"ec": "EC 9.1", "nom": "Humanités", "ue": "UE HUMANITES et CULTURE", "sem": "S3", "dn": "DNO2"}, {"ec": "EC 9.1", "nom": "Humanités", "ue": "UE HUMANITES et CULTURE", "sem": "S4", "dn": "DNO2"}, {"ec": "EC 17.1", "nom": "Humanités", "ue": "UE HUMANITES et CULTURE", "sem": "S5", "dn": "DNO3"}, {"ec": "EC 17.1", "nom": "Humanités", "ue": "UE HUMANITES et CULTURE", "sem": "S6", "dn": "DNO3"}, {"ec": "EC 9.2", "nom": "Culture des arts, du design et des techniques", "ue": "UE HUMANITES et CULTURE", "sem": "S3", "dn": "DNO2"}, {"ec": "EC 9.2", "nom": "Culture des arts, du design et des techniques", "ue": "UE HUMANITES et CULTURE", "sem": "S4", "dn": "DNO2"}, {"ec": "EC 17.2", "nom": "Culture des arts, du design et des techniques", "ue": "UE HUMANITES et CULTURE", "sem": "S5", "dn": "DNO3"}, {"ec": "EC 10.3", "nom": "Outils et langages numériques", "ue": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "sem": "S4", "dn": "DNO2"}, {"ec": "EC 2.5", "nom": "Contextes économiques et juridiques", "ue": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "sem": "S1", "dn": "DNO1"}, {"ec": "EC 3.3", "nom