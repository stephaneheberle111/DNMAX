11", "ecs": [{"id": "e8", "sems": ["S2", "S3"]}]}, {"id": "c34", "bloc": "11", "ecs": [{"id": "e8", "sems": ["S1", "S2", "S3"]}]}, {"id": "c35", "bloc": "11", "ecs": [{"id": "e3", "sems": ["S4", "S5", "S6"]}, {"id": "e4", "sems": ["S3", "S4"]}, {"id": "e8", "sems": ["S2", "S3", "S4", "S5"]}]}, {"id": "c36", "bloc": "11", "ecs": [{"id": "e8", "sems": ["S3", "S4"]}, {"id": "e10", "sems": ["S5"]}]}]}, "dictionnaire": {"ues": [{"id": "u0", "nom": "UE HUMANITES et CULTURE", "code": "", "couleur": "#91CC78"}, {"id": "u1", "nom": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "code": "", "couleur": "#ECA765"}, {"id": "u2", "nom": "UE ATELIERS DE CREATION", "code": "", "couleur": "#79A9D3"}, {"id": "u3", "nom": "UE PROFESSIONNALISATION", "code": "", "couleur": "#D394B5"}], "ecs": [{"id": "e0", "nom": "Humanités", "couleur": "#91CC78"}, {"id": "e1", "nom": "Culture des arts, du design et des techniques", "couleur": "#B8E778"}, {"id": "e2", "nom": "Outils d'expression et d'exploration créative", "couleur": "#E4E432"}, {"id": "e3", "nom": "Technologies et matériaux", "couleur": "#D1D174"}, {"id": "e4", "nom": "Outils et langages numériques", "couleur": "#F0BB39"}, {"id": "e5", "nom": "Langues vivantes", "couleur": "#F5AB66"}, {"id": "e6", "nom": "Contextes économiques et juridiques", "couleur": "#F09569"}, {"id": "e7", "nom": "Techniques et savoir-faire", "couleur": "#8DABC7"}, {"id": "e8", "nom": "Pratiques et mises en œuvre du projet", "couleur": "#79A9D3"}, {"id": "e9", "nom": "Communication et médiation du projet", "couleur": "#9FDBE8"}, {"id": "e10", "nom": "Démarche de recherche en lien avec la pratique de projet", "couleur": "#96C8D1"}, {"id": "e11", "nom": "Parcours de professionnalisation et poursuite d'étude", "couleur": "#E260A4"}, {"id": "e12", "nom": "Stage", "couleur": "#D394B5"}], "blocs": [{"id": "bmwc7rcfp6rf", "num": "1", "nom": "Utiliser les outils numériques de référence"}, {"id": "bmwc7rcfpkuh", "num": "2", "nom": "S'exprimer et communiquer à l'oral, à l'écrit et dans au moins une langue étrangère"}, {"id": "bmwc7rcfpvbu", "num": "3", "nom": "Se positionner vis-à-vis d'un champ professionnel"}, {"id": "bmwc7rcfpfvi", "num": "4", "nom": "Exploiter des données à des fins d'analyse"}, {"id": "bmwc7rcfpf24", "num": "5", "nom": "Agir en tant que professionnel dans le domaine Objet"}, {"id": "bmwc7rcfpphx", "num": "6", "nom": "Exercer des activités de veille professionnelle en design et métiers d'art"}, {"id": "bmwc7rcfpdax", "num": "7", "nom": "Employer différentes techniques d'information et de communication en design et métiers d'art"}, {"id": "bmwc7rcfpf7z", "num": "8", "nom": "Coopérer et travailler en équipe"}, {"id": "bmwc7rcfp7qk", "num": "9", "nom": "Elaborer une stratégie personnelle relative aux métiers de design d'objet"}, {"id": "bmwc7rcfpd8v", "num": "10", "nom": "Développer et mettre en œuvre des outils de création et de recherche relevant du design d'objet"}, {"id": "bmwc7rcfpd7m", "num": "11", "nom": "Concevoir, conduire et superviser une production relevant du design d'objet"}], "competences": [{"id": "c0", "code": "C1.1", "libelle": "Utiliser les outils numériques de référence et les règles de sécurité informatique pour acquérir, traiter, produire et diffuser de l'information ainsi que pour collaborer en interne et en externe."}, {"id": "c1", "code": "C2.1", "libelle": "Se servir aisément des différents registres d'expression écrite et orale de la langue française."}, {"id": "c2", "code": "C2.2", "libelle": "Communiquer par oral et par écrit, de façon claire et non ambiguë, dans au moins une langue vivante étrangère."}, {"id": "c3", "code": "C3.1", "libelle": "Désigner les ressources, mettre en oeuvre les outils et les méthodes de recherche propres au champ professionnel abordé."}, {"id": "c4", "code": "C3.2", "libelle": "Expérimenter des outils de création et de recherche plastique et conceptuelle permettant de structurer les étapes d'un projet et leurs interactions."}, {"id": "c5", "code": "C3.3", "libelle": "Caractériser et valoriser son identité, ses compétences et son projet professionnel."}, {"id": "c6", "code": "C4.1", "libelle": "Identifier, sélectionner et analyser avec esprit critique diverses ressources dans son domaine de spécialité."}, {"id": "c7", "code": "C4.2", "libelle": "Recueillir des ressources pour documenter un sujet et synthétiser ces données en vue de leur exploitation."}, {"id": "c8", "code": "C4.3", "libelle": "Analyser et synthétiser des données en vue de leur exploitation."}, {"id": "c9", "code": "C4.4", "libelle": "Développer une argumentation avec un esprit critique."}, {"id": "c10", "code": "C5.1", "libelle": "Situer son rôle et sa mission au sein d'une organisation pour s'adapter et prendre des initiatives."}, {"id": "c11", "code": "C5.2", "libelle": "Respecter les principes d'éthique, de déontologie et de responsabilité environnementale."}, {"id": "c12", "code": "C5.3", "libelle": "Identifier et situer les champs professionnels potentiellement en relation avec les acquis de la mention ainsi que les parcours possibles pour y accéder."}, {"id": "c13", "code": "C5.4", "libelle": "Prendre en compte l'environnement économique de l'activité professionnelle et appréhender des démarches entrepreneuriales."}, {"id": "c14", "code": "C6.1", "libelle": "Identifier les enjeux du domaine et des métiers au regard de l'actualité et des perspectives d'évolution, dans une démarche prospective."}, {"id": "c15", "code": "C6.2", "libelle": "S'informer des pratiques d'atelier et des productions émergentes associant ou non le numérique et la CFAO."}, {"id": "c16", "code": "C7.1", "libelle": "Développer ses propres ressources, méthodes et outils de médiation et de communication."}, {"id": "c17", "code": "C7.2", "libelle": "Veiller à l'adéquation des connaissances et compétences aux évolutions et besoin du métier."}, {"id": "c18", "code": "C8.1", "libelle": "Entretenir des liens et dialoguer au sein des équipes, avec les partenaires du projet et les experts associés."}, {"id": "c19", "code": "C8.2", "libelle": "Partager ses connaissances au sein d'une équipe et d'un réseau d'acteurs professionnels pluridisciplinaires."}, {"id": "c20", "code": "C8.3", "libelle": "Engager sa responsabilité au service du projet en prenant en compte les outils et méthodes de conception, de création et de réalisation."}, {"id": "c21", "code": "C9.1", "libelle": "Faire état d'une écriture et d'une pratique expérimentale personnelle : des dimensions plastique, sensorielle, graphique, volumique,fonctionnelles technologique, structurelle et signifiante des objets et de leur structuration."}, {"id": "c22", "code": "C9.2", "libelle": "Formaliser et rendre visible ses expériences pour valoriser son identité personnelle : - dans la conception et le pilotage de projets relatifs à l'objet. - dans la gestion de projet et la réalisation d'objets."}, {"id": "c23", "code": "C9.3", "libelle": "S'auto évaluer et se remettre en question pour apprendre : - Maîtrise des outils, protocoles et techniques relevant de l'objet. - Développement d'une culture professionnelle de l'objet."}, {"id": "c24", "code": "C10.1", "libelle": "Définir une approche collaborative avec l'ensemble des acteurs concernés : client, service marketing, recherche et développement, ergonomes, fabricant, technicien, artisans, usager et, selon l'échelle du programme, sémiologue, sociologue, philosophe, historien…"}, {"id": "c25", "code": "C10.2", "libelle": "Proposer des orientations créatives et prospectives relevant du domaine de l'objet."}, {"id": "c26", "code": "C10.3", "libelle": "Expérimenter les différents champs d'hypothèses en prenant en compte l'aspect formel (plastique, volumique, technologique), l'aspect structurel (organisation, articulation des systèmes), leur sens (dimension sémantique), l'usage, le rapport à l'utilisateur (expérience, ergonomie), les matériaux, les process et le rapport à l'environnement (cycle de vie, écoconception)."}, {"id": "c27", "code": "C10.4", "libelle": "Au regard de la demande initiale cahier des charges, commande, vérifier la faisabilité technique et économique de production du projet relevant de l'objet."}, {"id": "c28", "code": "C10.5", "libelle": "Veiller au respect des échéances et au contrôle technique et artistique selon les contraintes budgétaires, administratives, techniques, légales."}, {"id": "c29", "code": "C10.6", "libelle": "Énoncer ses idées d'objets et de services, argumenter ses choix au travers de supports et de média adaptés 2D et/ou 3D et/ou supports vidéos et/ou interactifs."}, {"id": "c30", "code": "C10.7", "libelle": "Mettre en oeuvre les matériaux, les techniques et les technologies innovantes ou traditionnelles, dans le cadre de la conception et de la réalisation partielle d'un projet et dans l'adaptation des process de fabrication, en prenant en compte le cycle de vie et la durabilité (conception d'objets et de leur environnement: produits, procédés, services ou systèmes)."}, {"id": "c31", "code": "C11.1", "libelle": "Saisir les éléments caractéristiques d'un projet relevant de l'objet au travers de maquettes et d'échantillons en prenant en compte les étapes de fabrication."}, {"id": "c32", "code": "C11.2", "libelle": "Prototyper ou réaliser tout ou partie du projet en incluant les outils numériques CAO, DAO, PAO."}, {"id": "c33", "code": "C11.3", "libelle": "Établir des principes d'évolution du projet relevant de l''objet selon des critères explicités."}, {"id": "c34", "code": "C11.4", "libelle": "Faire la démonstration que le projet relevant de l'objet est bien en adéquation avec la demande initiale et son économie générale."}, {"id": "c35", "code": "C11.5", "libelle": "Planifier et gérer les différentes étapes d'un projet jusqu'à son rendu et sa validation en prenant en compte les aspects techniques et réglementaires."}, {"id": "c36", "code": "C11.6", "libelle": "Favoriser le dialogue au sein des équipes et avec les partenaires du projet et les experts associés: client, service marketing, recherche et développement, ergonomes, fabricant, technicien, artisans, usager et, selon l'échelle du programme, sémiologue, sociologue, philosophe, historien…"}]}, "contenuLisible": {"meta": {"niveaux": [{"code": "", "label": "Initié", "annee": 1, "semestres": ["S1", "S2"]}, {"code": "", "label": "Guidé", "annee": 2, "semestres": ["S3", "S4"]}, {"code": "", "label": "Autonomie", "annee": 3, "semestres": ["S5", "S6"]}]}, "blocs": [{"num": "1", "nom": "Utiliser les outils numériques de référence"}, {"num": "2", "nom": "S'exprimer et communiquer à l'oral, à l'écrit et dans au moins une langue étrangère"}, {"num": "3", "nom": "Se positionner vis-à-vis d'un champ professionnel"}, {"num": "4", "nom": "Exploiter des données à des fins d'analyse"}, {"num": "5", "nom": "Agir en tant que professionnel dans le domaine Objet"}, {"num": "6", "nom": "Exercer des activités de veille professionnelle en design et métiers d'art"}, {"num": "7", "nom": "Employer différentes techniques d'information et de communication en design et métiers d'art"}, {"num": "8", "nom": "Coopérer et travailler en équipe"}, {"num": "9", "nom": "Elaborer une stratégie personnelle relative aux métiers de design d'objet"}, {"num": "10", "nom": "Développer et mettre en œuvre des outils de création et de recherche relevant du design d'objet"}, {"num": "11", "nom": "Concevoir, conduire et superviser une production relevant du design d'objet"}], "ues": [{"nom": "UE HUMANITES et CULTURE", "code": "", "sems": ["S1", "S2", "S3", "S4", "S5", "S6"]}, {"nom": "UE METHODOLOGIES, TECHNIQUES ET LANGUES", "code": "", "sems": ["S1", "S2", "S3", "S4", "S5", "S6"]}, {"nom": "UE ATELIERS DE CREATION", "code": "", "sems": ["S1", "S2", "S3", "S4", "S5", "S6"]}, {"nom": "UE PROFESSIONNALISATION", "code": "", "sems": ["S1", "S2", "S3", "S4", "S5", "S6"]}], "ecs": [{"nom": "Humanités", "codes": {"1": "EC 1.1", "2": "EC 9.1", "3": "EC 17.1"}, "ue": "UE HUMANITES et CULTURE", "sems": ["S1", "S2", "S3", "S4", "S5", "S6"]}, {"no