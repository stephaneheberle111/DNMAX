{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DNMAX",
  "version": "../package.json",
  "identifier": "fr.dnmax.app",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DNMAX",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "AGPL-3.0-or-later",
    "shortDescription": "Évaluations par compétences en DN MADE",
    "category": "Education",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQjUwODAyMjg0NzJBOEQKUldTTktrY29BZ2kxSUdJbEtoUCtOK2tWcFpWbm5HSWp5V1RnWnJKU1p6V1k4em1BZDNFNHBJd3QK",
      "endpoints": [
        "https://github.com/stephaneheberle111/DNMAX/releases/latest/download/latest.json"
      ]
    }
  }
}
