{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de la fenêtre principale : le strict nécessaire.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://dnmax.pages.dev/*"
        },
        {
          "url": "https://github.com/stephaneheberle111/DNMAX"
        },
        {
          "url": "https://github.com/stephaneheberle111/DNMAX/*"
        }
      ]
    }
  ]
}
